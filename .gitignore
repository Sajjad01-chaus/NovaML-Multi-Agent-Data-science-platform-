api/
data/
models/
plots/

# 1. Virtual Environments
# Never push your environment folder
myvenv/
venv/
.venv/
env/

# 2. API Keys & Secrets
# CRITICAL: Never push your .env file
.env
config.yaml

# 3. Python Cache & Logs
# These are auto-generated by Python
__pycache__/
*.py[cod]
*.log
.DS_Store

# 4. Project-Specific Artifacts
# We don't want to push large datasets, models, or generated files
/data/*
/models/*
/api/*
/plots/*

# 5. IDE Files
# Common files from editors like VSCode
.vscode/
.idea/