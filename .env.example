# Copy to .env. Every setting is optional; see src/novaml/config.py.

# Free Groq key: https://console.groq.com/keys
# With a key set, the default provider (auto) uses Groq; without one, every agent
# runs its deterministic policy, so the platform still works fully offline.
# GROQ_API_KEY=

# auto | groq | none   (anthropic is also supported but needs a paid key)
NOVAML_LLM_PROVIDER=auto
# Primary model and fallbacks (each Groq model has its own free-tier quota).
# NOVAML_LLM_MODEL=openai/gpt-oss-120b
# NOVAML_LLM_FALLBACK_MODELS=["qwen/qwen3.8-27b","openai/gpt-oss-20b"]

# Hard cap on LLM tokens per run; agents fall back to policies when exhausted.
# Groq free tier is ~200K tokens/day per model, so 60K allows a few runs a day.
NOVAML_RUN_TOKEN_BUDGET=60000

# Skip human approval (batch / eval runs)
NOVAML_AUTO_APPROVE=false

NOVAML_DATA_DIR=var

# --- Service mode (docker compose sets these for you) -----------------------
# NOVAML_DATABASE_URL=postgresql://novaml:novaml@localhost:5432/novaml   # default: SQLite under NOVAML_DATA_DIR
# NOVAML_ARTIFACT_BACKEND=s3                                            # default: local
# NOVAML_S3_BUCKET=novaml
# NOVAML_S3_ENDPOINT_URL=http://localhost:9000                          # MinIO / R2; omit for AWS S3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# NOVAML_WORKER_LEASE_S=120        # job re-queued if its worker stops heart-beating this long
# NOVAML_JOB_MAX_ATTEMPTS=3
